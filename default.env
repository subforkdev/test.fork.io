#!/usr/bin/env envstack
include: [secrets]
all: &all
  DEBUG: ${DEBUG:=false}
  ENV: ${ENV:=prod}
  SUBFORK_DOMAIN: test.fork.io
  SUBFORK_ACCESS_KEY: ${SUBFORK_ACCESS_KEY}
  SUBFORK_SECRET_KEY: ${SUBFORK_SECRET_KEY}
  DEPLOY_ROOT: ${ROOT}/${ENV}
  ENVPATH: ${DEPLOY_ROOT}/env:${ENVPATH}
  PATH: ${DEPLOY_ROOT}/bin:${PATH}
  PYTHONPATH: ${DEPLOY_ROOT}/lib/python:${DEPLOY_ROOT}/build
darwin:
  <<: *all
linux:
  <<: *all
windows:
  <<: *all
